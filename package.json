{
  "name": "sia-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vite",
    "generate:assets": "bun scripts/generate-assets.mjs",
    "generate:hero-images": "bun scripts/generate-hero-images.mjs",
    "vendor:fonts": "bun scripts/vendor-fonts.mjs",
    "submit:indexnow": "bun scripts/submit-indexnow.mjs",
    "build": "tsc && vite build && bun scripts/run-prerender.ts && bun scripts/verify-static-output.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:http": "vitest run src/__tests__/http.test.ts"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "jsdom": "^27.4.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "rehype-pretty-code": "^0.14.6",
    "sharp": "^0.35.5",
    "shiki": "^3.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "fflate": "^0.8.3",
    "picomatch": "^4.0.7",
    "rollup": "^4.68.7",
    "source-map-js": "^1.2.3",
    "ws": "^8.23.0"
  }
}
